# PostgreSQL
POSTGRES_DB=reklamacje
POSTGRES_USER=reklamacje
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://reklamacje:CHANGE_ME_LONG_RANDOM_PASSWORD@postgres:5432/reklamacje

# Internal bridge -> backend authentication (generate a long random value)
BRIDGE_API_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# Exact WhatsApp group ID printed by: docker compose logs -f whatsapp
# Leave empty for the first QR login/group discovery run.
WHATSAPP_GROUP_ID=
ROOT_PATH=/reklamacjeOS
PANEL_ACTION_TOKEN=
GROUPING_WINDOW_MINUTES=10
WHATSAPP_CLIENT_ID=reklamacje-os
# Optional SOCKS proxy used only for initial pairing troubleshooting.
WHATSAPP_PROXY_SERVER=
HEALTH_PORT=3001
BACKUP_HOST_PATH=/var/backups/reklamacjeos
BACKUP_UID=1001
BACKUP_GID=1001
BACKUP_INTERVAL_SECONDS=86400
BACKUP_MAX_AGE_SECONDS=108000
BACKUP_FREE_SPACE_WARN_KB=10485760

# Public entry point and HTTP Basic Auth.
# For initial IP-only setup keep :80. For HTTPS use your DNS name, e.g. reklamacje.example.pl
SITE_ADDRESS=:80
PANEL_USER=admin
# Generate: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
PANEL_PASSWORD_HASH=CHANGE_ME_BCRYPT_HASH

# Upload limit enforced by backend (bytes); default below is 15 MiB.
MAX_UPLOAD_BYTES=15728640
TZ=Europe/Warsaw

# SMTP pozostaw puste, dopóki skrzynka nadawcza nie zostanie skonfigurowana.
SMTP_HOST=
SMTP_ENABLED=false
SMTP_SECRET_GID=1000
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Reklamacje DAMPOL
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=30
EMAIL_WORKER_INTERVAL_SECONDS=5

# TypeSafe Jev pozostaje wyłączony do czasu zapisania klucza w .secrets/typesafe_api_key.
TYPESAFE_ENABLED=false
TYPESAFE_SECRET_GID=1000
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=15
OCR_LANGUAGE=pol+eng
OCR_TIMEOUT_SECONDS=90
OCR_WORKER_INTERVAL_SECONDS=3
